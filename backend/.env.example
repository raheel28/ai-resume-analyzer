LLM_PROVIDER=gemini
GEMINI_API_KEY=your-key-here
LLM_MODEL=gemini-3.5-flash
# Tried in order if the main model is busy (503/429), times out, or isn't available.
LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash
LLM_TIMEOUT_S=25
CORS_ORIGINS=http://localhost:5173
# Per-visitor limits. Generous locally; render.yaml sets 10/hour for the live site.
AI_RATE_LIMIT=1000/hour
BASIC_RATE_LIMIT=1000/minute
